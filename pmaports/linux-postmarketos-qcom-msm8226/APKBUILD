abe11596d7d00b2a83d392a88e5d22c2cb415d3c7a1e336921d0405805ea8a37b115ba80a940d6b0dd2f06dfbcac75ddcc17fa8c12d19dfe03d60559749ee2c4  config-postmarketos-qcom-msm8226.armv7
