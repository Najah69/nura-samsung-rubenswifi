# Reference: <https://postmarketos.org/devicepkg>
# Calibration Wi-Fi (WCNSS) propre a la Galaxy Tab Active 8.0 Wi-Fi.
#
# Sur cette tablette, le fichier n'est PAS dans la partition persist mais dans
# system/etc/firmware/wlan/prima/ : le chargeur msm-firmware-loader ne le voit
# donc pas et wcn36xx refuse de demarrer sans lui. On le fournit ici, ce qui
# rend le Wi-Fi independant de la partition system.
maintainer="Najah <najah@users.noreply.github.com>"
pkgname=firmware-samsung-rubenswifi
pkgver=1
pkgrel=0
_name="Samsung Galaxy Tab Active 8.0"
pkgdesc="Firmware for $_name"
url="https://postmarketos.org"
subpackages="$pkgname-wcnss-nv:wcnss_nv"
arch="armv7"
license="proprietary"
options="!check !strip !archcheck !tracedeps pmb:cross-native"
_fwdir="/usr/lib/firmware/postmarketos"
# Sources locales : blobs extraits de la partition system de la tablette.
source="
	WCNSS_qcom_wlan_nv.bin
	WCNSS_qcom_cfg.ini
	"

package() {
	# Le paquet parent est vide : tout est dans le sous-paquet -wcnss-nv.
	mkdir -p "$pkgdir"
}

wcnss_nv() {
	pkgdesc="$_name WiFi firmware and calibration"
	install -Dm644 "$srcdir"/WCNSS_qcom_wlan_nv.bin \
		"$subpkgdir$_fwdir"/wlan/prima/WCNSS_qcom_wlan_nv.bin
	install -Dm644 "$srcdir"/WCNSS_qcom_cfg.ini \
		"$subpkgdir$_fwdir"/wlan/prima/WCNSS_qcom_cfg.ini
}

sha512sums="
9efbafa9b8eae3e7b73ae21a4e02206b4b545419ed3ede948a2f99957467cfb476e999a4d95fdbfc1d10ec2f16c385a3978ca5e73e2e9309d6d23bc6c4413bb5  WCNSS_qcom_wlan_nv.bin
4962f62d3aaced5ddd7d89bbac4da75a4d4b8b6484ed4532cb2e0522587043f40096bcafed952331bfa97c1a0d0bcd19cf93137981968ac0d82f86036ab06708  WCNSS_qcom_cfg.ini
"
