// Preferences IceWM — Galaxy Tab Active 8.0 (ecran 800x1280, usage tactile).
// Police volontairement grande : l'ecran fait 800 px de large.

TaskBarAutoHide = 0
TaskBarAtTop = 1
ShowTaskBar = 1
TaskBarShowClock = 1
TaskBarShowCPUStatus = 0
// Barre de lancement rapide (l'icone d'orientation) a gauche de la barre.
TaskBarShowToolBar = 1
IconSize = 32
TitleBarMaximized = 1
MenuMaxHeight = 26
WorkspaceNames = "POS"

TaskBarFontName = "-*-dejavu sans-medium-r-normal-*-*-140-*-*-*-*-*-*"
TaskBarClockFontName = "-*-dejavu sans-medium-r-normal-*-*-140-*-*-*-*-*-*"
MenuFontName = "-*-dejavu sans-medium-r-normal-*-*-150-*-*-*-*-*-*"
TitleFontName = "-*-dejavu sans-bold-r-normal-*-*-140-*-*-*-*-*-*"
StatusFontName = "-*-dejavu sans-medium-r-normal-*-*-130-*-*-*-*-*-*"
ToolTipFontName = "-*-dejavu sans-medium-r-normal-*-*-140-*-*-*-*-*-*"
DialogFontName = "-*-dejavu sans-medium-r-normal-*-*-140-*-*-*-*-*-*"
MessageFontName = "-*-dejavu sans-medium-r-normal-*-*-140-*-*-*-*-*-*"

// Fond du bureau. IceWM 4 attend le chemin dans DesktopBackgroundImage ;
// DesktopBackgroundCenter et DesktopBackgroundScaled sont des options vrai/faux.
// (L ancienne cle DesktopBackgroundCenter a un chemin venait d IceWM 1.x : icewmbg
// refusait de demarrer, d ou un bureau noir.)
DesktopBackgroundImage = "/usr/share/pixmaps/fond-nura.png"
DesktopBackgroundScaled = 1
DesktopBackgroundCenter = 1
