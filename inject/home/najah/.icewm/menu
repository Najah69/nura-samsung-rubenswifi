# Menu IceWM de la Galaxy Tab Active - v2 : tout au doigt, entree principale =
# l'assistant Nura. Les outils restent accessibles dans les sous-menus.

prog "Assistant Nura (configuration)" folder /usr/local/bin/nura-assistant --menu
prog "Basculer l'ecran (paysage/portrait)" /usr/share/pixmaps/orientation.xpm /usr/local/bin/orientation.sh bascule
prog "Clavier tactile (afficher/masquer)" /usr/share/pixmaps/keyboard.xpm /usr/local/bin/keyboard.sh bascule
prog "Batterie" folder xterm -xrm "XTerm*font: 10x20" -geometry 78x20 -e /usr/local/bin/batterie.sh

menu "Web" folder {
	prog "Netsurf (leger, rapide)" folder /usr/local/bin/navigateur.sh netsurf
	prog "Firefox (sites modernes, lent)" folder /usr/local/bin/navigateur.sh firefox
}

menu "Reseau" folder {
	prog "Choisir un reseau Wi-Fi" folder xterm -xrm "XTerm*font: 10x20" -geometry 78x32 -e /usr/local/bin/wifi.sh scan
	prog "Etat du Wi-Fi" folder xterm -xrm "XTerm*font: 10x20" -geometry 78x32 -e /usr/local/bin/wifi.sh status
	prog "Reseau USB : etat" folder xterm -xrm "XTerm*font: 10x20" -geometry 78x24 -e /usr/local/bin/reseau-usb.sh etat
	prog "Reseau USB : activer" folder xterm -xrm "XTerm*font: 10x20" -geometry 78x24 -e /usr/local/bin/reseau-usb.sh up
	prog "Reseau USB : couper" folder /usr/local/bin/reseau-usb.sh down
}

menu "Fichiers" folder {
	prog "Midnight Commander" folder xterm -xrm "XTerm*font: 10x20" -geometry 78x32 -e mc
	prog "Supports montes" folder xterm -xrm "XTerm*font: 10x20" -geometry 78x20 -e /usr/local/bin/automount.sh etat
	prog "Monter les supports" folder /usr/local/bin/automount.sh tout
	prog "nano (editer un fichier)" folder xterm -xrm "XTerm*font: 10x20" -geometry 78x32 -e nano
	prog "Kitty (terminal moderne)" /usr/share/icons/hicolor/256x256/apps/kitty.png /usr/bin/kitty -o font_size=12
	prog "Terminal (xterm, leger)" /usr/share/pixmaps/xterm-color_32x32.xpm xterm
}

menu "Son" folder {
	prog "Bluetooth : appairer une enceinte" folder blueman-manager
	prog "Volume et sortie du son" folder pavucontrol
}

menu "Ecran" folder {
	prog "Paysage 1280x800" /usr/share/pixmaps/orientation.xpm /usr/local/bin/orientation.sh paysage
	prog "Portrait 800x1280" /usr/share/pixmaps/orientation.xpm /usr/local/bin/orientation.sh portrait
	prog "Etat de l'ecran" folder xterm -xrm "XTerm*font: 10x20" -geometry 78x32 -e /usr/local/bin/orientation.sh etat
	prog "Eteindre l'ecran (Power pour rallumer)" folder systemctl kill -s USR1 nura-energie.service
	prog "Luminosite +" folder /usr/local/bin/luminosite.sh plus
	prog "Luminosite -" folder /usr/local/bin/luminosite.sh moins
	prog "Luminosite 25 %" folder /usr/local/bin/luminosite.sh 25%
	prog "Luminosite 50 %" folder /usr/local/bin/luminosite.sh 50%
	prog "Luminosite 100 %" folder /usr/local/bin/luminosite.sh 100%
}

menu "Diagnostic" folder {
	prog "Rapport complet" folder xterm -xrm "XTerm*font: 10x20" -geometry 78x32 -e /usr/local/bin/x11-diag.sh
	prog "Journaux du noyau" folder xterm -xrm "XTerm*font: 10x20" -geometry 78x32 -e dmesg
	prog "Etiquettes des entrees" folder xterm -xrm "XTerm*font: 10x20" -geometry 78x32 -e cat /proc/bus/input/devices
}

prog "Redemarrer" system-reboot systemctl reboot
prog "Eteindre" system-shutdown systemctl poweroff
